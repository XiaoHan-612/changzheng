# 依赖
node_modules/

# 密钥与本机设置：绝不入库
.env
runtime-config.json

# 测试运行产物
tests/e2e/artifacts/

# 日志是运行产物：逐日变动会把 diff 冲成噪音，8MB 轮转还会把当天最早的记录裁掉。
# 仓库里只留 logs/sample-full-run.jsonl 一份真实全程样本（见 logs/README.md）。
logs/ai-calls-*.jsonl
logs/session-full.jsonl
logs/server-out.txt
logs/archive/

# 离线回放包（备选方案未开发；一旦开发，排练稿不进源码历史，见 docs/OFFLINE-REPLAY.md）
data/replay/

# 环境床的 WAV 兼容格式：能用，但体积约为 Ogg 的 10 倍。
# 等音频模型按同名导出 Ogg Vorbis 后再入库（代码优先用 .ogg）。
public/audio/ambient/*.wav

# 终局升华的整段朗诵：网上找的/别人录的音频**不进公开仓库**（仓库是公开的），
# 本机与演示机照常能播。目录里那份"怎么放"的说明留着（public/audio/poem/README.md）。
public/audio/poem/*
!public/audio/poem/README.md
