{
  "name": "changzheng-juze",
  "version": "0.2.0",
  "description": "《长征·抉择》— 五幕 AI 科普互动游戏（赛道二）",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "npm run test:unit && npm run test:e2e && npm run qa:sandbox",
    "test:unit": "node --test tests/unit/state.test.js tests/unit/config.test.js tests/unit/schema.test.js tests/unit/origin.test.js tests/unit/acts.test.js tests/unit/balance.test.js",
    "test:e2e": "node tests/e2e/full-run.mjs",
    "test:e2e:headed": "node tests/e2e/full-run.mjs --headed",
    "qa:smoke": "node tests/e2e/smoke.mjs",
    "qa:sandbox": "node tests/e2e/sandbox.mjs",
    "qa:regress": "node tests/e2e/regressions.mjs",
    "qa:failure": "node tests/e2e/march-failure.mjs",
    "qa:playtest": "node tests/e2e/playtest.mjs",
    "qa:av": "node tests/e2e/av-audit.mjs",
    "qa:audio": "node scripts/check-audio.mjs",
    "qa:audit": "node scripts/audit-logs.mjs",
    "qa:assets": "node tests/e2e/asset-drop.mjs",
    "qa:inspect": "node scripts/inspect-assets.mjs",
    "qa:tts": "node scripts/check-tts.mjs",
    "qa:look": "node tests/manual/asset-look.mjs",
    "qa:handoff": "node scripts/check-handoff.mjs",
    "tts:manifest": "node scripts/tts-manifest.mjs",
    "check:glm": "node scripts/check-glm.mjs",
    "reset:logs": "node scripts/reset-logs.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
