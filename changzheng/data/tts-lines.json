    { "id": "candy_open", "actor": "红小鬼", "voiceId": "xiaogui", "when": "分糖·开场", "text": "我兜里有三颗糖。你说，给谁？" },
    { "id": "snow_grab_open", "actor": "你", "voiceId": "narr", "when": "陡坡·开场", "text": "他的手在滑。前面的雪是硬的，下面是空的。" },
    { "id": "roster_open", "actor": "你", "voiceId": "narr", "when": "会师·清点", "text": "队伍汇合了，人山人海。你在人群里找那些熟悉的脸。" },
    { "id": "night_open", "actor": "旁白", "voiceId": "narr", "when": "篝火夜·开场", "text": "火压低了。后半夜怎么过，明天的口粮怎么带，得在火边定下来。" }
