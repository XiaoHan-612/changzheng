    { "id": "fact_h_huining", "actor": "旁白", "voiceId": "narr", "when": "史实回响·标题", "text": "会宁会师" },
    { "id": "sentry_open", "actor": "哨兵", "voiceId": "sentry", "when": "夜岗·开场", "text": "后半夜归你。听不清就再听一遍，别急着开枪。" },
