# 智谱 GLM-5.1（天津移动指定接口）
# 必须配置 Key：本项目没有 MOCK 兜底，未配置时调用会报错并写入 source=ERROR

GLM_API_KEY=
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# 赛制指定 glm-5.1；本机网络受限时可用 glm-5.3-flash 替代（日志 model 字段会如实记录）
GLM_MODEL=glm-5.1
# glm-5.3-flash 等「始终思考」的模型必须设这个，否则 token 被推理吃光、content 返回空
# 可选 low | high | max；low 最快最省，答辩若嫌叙事浅可调 high
GLM_REASONING_EFFORT=low
PORT=3001
