# 依赖
node_modules/

# 密钥与本机设置：绝不入库
.env
runtime-config.json

# 运行产物（可重新生成）——不带中间斜杠，按文件名匹配任意层级
session-full.jsonl
server-out.txt
server-err.txt
**/tests/e2e/artifacts/
# 逐屏截图产物（tests/manual/shot-all.mjs 输出）：可随时重跑，和 e2e/artifacts 一样不进仓库
changzheng/logs/shots/

# 编辑器 / 系统
.DS_Store
Thumbs.db
*.log

# 归档区（_archive/）只跟踪代码与文档：
# 里面的场景原画、截图、配音都是被 changzheng/ 取代的旧素材，保留在磁盘但不必入库，
# 避免仓库被 ~65MB 位图撑大。确实需要版本管理就删掉下面四行。
_archive/**/*.png
_archive/**/*.jpg
_archive/**/*.jpeg
_archive/**/*.wav

# ZCode 客户端的过程文件（计划稿等）：是工具产物，不是源码
.zcode/

# 音频素材同理（mp3 是 2026-09 起为整段朗诵放开的一种容器）
_archive/**/*.mp3
_archive/**/*.ogg

# 本机的音频生成工具链（soundfile/cffi 的 whl + make_audio2.py）：产出用的，别入源码库
_archive/audio-toolchain/

# 同事的小游戏交接包（v1 = 文档 + 单支源码 / v2 = 含完整检出）：本地参考，不进源码历史。
# 真正要接进工程的东西已经拷进 changzheng/public/js/modules/games/src/ 与 changzheng/docs/minigames/。
_archive/handoff-minigames-*/

# 桌面封装（packaging/）：只入库脚本与说明，运行时与产物都不入库（体积大且可重建）
# 重建办法见 packaging/README.md：cd packaging && node build.mjs
dist/
packaging/electron-dist/
packaging/.electron-cache/
packaging/.npm-cache/
packaging/.singlefile/
packaging/.verify-state/
packaging/.test-state*/
packaging/icon.ico
packaging/icon.png
packaging/verify-shot.png
packaging/verify-fast-shot.png

# 旧“桌面版”solo 线的文档快照（2026-09-17，内容已被 changzheng/docs 取代，
# 完整历史在 tag `solo-v0.3-2026-09-17`）：留档用，不进源码历史
_archive/solo-v0.3-2026-09-17/
